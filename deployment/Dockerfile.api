# Optional DEVELOPMENT container. Production hardening/authentication pending.
FROM rocker/r-ver:4.4.2
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4-openssl-dev libssl-dev libpng-dev && \
    rm -rf /var/lib/apt/lists/*
COPY install_packages.R ./
RUN Rscript install_packages.R
COPY . ./
ENV DIGITAL_TAGGING_API_HOST=0.0.0.0 DIGITAL_TAGGING_API_PORT=8000
EXPOSE 8000
CMD ["Rscript", "run_api.R"]
